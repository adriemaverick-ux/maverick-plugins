{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*(send|publish|post|schedule|message|sms|email|whatsapp|create_contact|update_contact|delete|workflow|campaign|bulk).*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/confirmar-envio.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/frenar-secretos.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/recordar-no-improvisar.sh SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/recordar-no-improvisar.sh UserPromptSubmit"
          }
        ]
      }
    ]
  }
}